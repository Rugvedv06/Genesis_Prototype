{
  "name": "healr",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "healr \u2014 PS 01 Self-Healing Tool Registry build plan scaffold (Phase 0)",
  "workspaces": [
    "packages/llm",
    "api-server",
    "api-client",
    "demo-server-and-client/server",
    "demo-server-and-client/client"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "test": "node --import ./scripts/test-env.mjs --test \"api-server/test/**/*.test.js\" \"demo-server-and-client/server/test/**/*.test.js\" \"packages/llm/test/**/*.test.js\" \"scripts/**/*.test.js\"",
    "verify:p01": "node scripts/verify-phase01.mjs",
    "verify:m5:live": "node scripts/verify-m5-live.mjs",
    "db:migrate": "npm --workspace=api-server run db:migrate",
    "db:import": "node api-server/src/db/importer/preflight-cli.js",
    "db:import:dry-run": "node api-server/src/db/importer/preflight-cli.js --dry-run",
    "db:seed": "node api-server/src/db/seed-demo-data.js",
    "db:retention": "node api-server/src/db/retention.js",
    "db:backup": "sh scripts/db-backup.sh",
    "db:restore:drill": "sh scripts/db-restore-drill.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  }
}
