# PS 01 environment (ports fixed by plan: core 8000, mock 5001, dashboards 3000/3001)
GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2,your_gemini_key_3,your_gemini_key_4
# Legacy fallback when GEMINI_API_KEYS is unset
GEMINI_API_KEY=
AGENT_LLM=gemini:gemini-2.5-flash
DIAGNOSER_LLM=gemini:gemini-2.5-flash
BASELINE_MODE=llm
LLM_MAX_CONCURRENCY=4
TIER2_TIMEOUT_MS=2500
TIER2_MAX_CALLS_PER_HEAL=2
SPEC_CACHE_TTL_MS=5000
OPENAPI_IMPORT_TIMEOUT_MS=1800
AGENT_MAX_STEPS=8
AGENT_RUN_TIMEOUT_MS=60000
AGENT_MAX_CONCURRENT_RUNS=8
CORE_URL=http://localhost:8000
MOCK_URL=http://localhost:5001
TENANT_ID=demo-tenant-01
ENABLE_DEV_ROUTES=1
PORT=8000
NEXT_PUBLIC_CORE_URL=http://localhost:8000
NEXT_PUBLIC_MOCK_URL=http://localhost:5001
HEALR_DATA_DIR=./data
MAX_HEAL_ROUNDS=5
HEAL_TIMEOUT_MS=5000
ALLOW_LOCAL_UPSTREAMS=1
# Local persistence services (docker compose up -d postgres redis)
POSTGRES_DB=healr
POSTGRES_USER=healr
POSTGRES_PASSWORD=healr_dev_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://healr:healr_dev_only@127.0.0.1:5432/healr
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379
