# PS 01 environment (ports fixed by plan: core 8000, mock 5001, dashboards 3000/3001)
GEMINI_API_KEY=your_gemini_api_key_here
AGENT_LLM=gemini:gemini-2.5-flash
DIAGNOSER_LLM=gemini:gemini-2.5-flash
BASELINE_MODE=scripted
CORE_URL=http://localhost:8000
MOCK_URL=http://localhost:5001
TENANT_ID=demo-tenant-01
ENABLE_DEV_ROUTES=1
PORT=8000
NEXT_PUBLIC_CORE_URL=http://localhost:8000
NEXT_PUBLIC_MOCK_URL=http://localhost:5001
HEALR_DATA_DIR=./data
MAX_HEAL_ROUNDS=5
HEAL_TIMEOUT_MS=5000
ALLOW_LOCAL_UPSTREAMS=1
# Local persistence services (docker compose up -d postgres redis)
POSTGRES_DB=healr
POSTGRES_USER=healr
POSTGRES_PASSWORD=healr_dev_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://healr:healr_dev_only@127.0.0.1:5432/healr
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379
