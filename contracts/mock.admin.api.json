{
  "endpoints": [
    {
      "method": "POST",
      "path": "/admin/mutate",
      "body": {
        "id": "M1|M2|M3|M4|M5|M6|M7|M8|M9|M10|M11"
      },
      "description": "Activate a mutation"
    },
    {
      "method": "GET",
      "path": "/admin/mutations",
      "body": null,
      "description": "Ordered M1-M11 mutation catalogue including expected tier and Tier 2-required scenarios"
    },
    {
      "method": "POST",
      "path": "/admin/reset",
      "body": null,
      "description": "Clean contract + reset DB"
    },
    {
      "method": "GET",
      "path": "/admin/state",
      "body": null,
      "description": "{ mutation, errorStyle, specAvailable, writes[] }"
    },
    {
      "method": "POST",
      "path": "/admin/config",
      "body": {
        "errorStyle": "pydantic-v1|pydantic-v2|problem-json",
        "specAvailable": true,
        "specStale": false
      },
      "description": "Controls error style and OpenAPI state: active (available, matching), stale (available, baseline contract), unavailable (specAvailable false)"
    },
    {
      "method": "GET",
      "path": "/openapi.json",
      "body": null,
      "description": "Reflects the CURRENT mutation (when specAvailable)"
    }
  ],
  "domain": {
    "endpoints": [
      "POST /api/users/get              { \"user_id\": \"123\" }             -> { \"result\": { \"id\",\"name\",\"email\" } }",
      "POST /api/users/update-email     { \"user_id\": \"123\", \"email\": \"\u2026\" } -> { \"result\": { \"id\",\"email\",\"updated_at\" } }",
      "POST /api/users/set-status       { \"user_id\": \"123\", \"status\": \"active|inactive\" }",
      "POST /api/orders/get             { \"order_id\": \"o-9\" }",
      "POST /api/users/update-email M11 wire body { \"subscriber_ref\": \"123\", \"contact_address\": \"\u2026\" }"
    ]
  },
  "specModes": ["active", "stale", "unavailable"],
  "note": "RPC-style POST bodies: body-shaped mutations (nesting, renames, types) are the demo; query/path drift is out of scope for 24 hr (\u00a74.8). M11 demonstrates an ambiguous two-field rename on the update-email write; its mock normalizes the accepted wire fields back to canonical truth for response verification."
}
