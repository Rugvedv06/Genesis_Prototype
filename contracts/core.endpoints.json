{
  "endpoints": [
    { "method": "GET",    "path": "/apis",                          "description": "List registered APIs and current versions", "status": "live" },
    { "method": "GET",    "path": "/apis/:apiId",                   "description": "API detail and configuration", "status": "live" },
    { "method": "PATCH",  "path": "/apis/:apiId/config",             "description": "Update healing configuration", "status": "live" },
    { "method": "POST",   "path": "/apis",                          "description": "Register an API (§4.1 payload)", "status": "live" },
    { "method": "DELETE", "path": "/apis/:apiId",                   "description": "Remove an API (demo reset)", "status": "live" },
    { "method": "GET",    "path": "/apis/:apiId/tools/:tool/versions","description": "Tool version history", "status": "live" },
    { "method": "GET",    "path": "/apis/:apiId/tools/:tool/versions/:n","description": "Single version record", "status": "live" },
    { "method": "GET",    "path": "/apis/:apiId/tools/:tool/diff",   "description": "Compare two adapter versions", "status": "live" },
    { "method": "POST",   "path": "/apis/:apiId/tools/:tool/rollback","description": "Roll back: appends a NEW version with rollbackOf", "status": "live" },
    { "method": "POST",   "path": "/apis/:apiId/tools/:tool/invoke", "description": "Core invoke API (§4.4)", "status": "live" },
    { "method": "POST",   "path": "/tasks",                         "description": "Scripted task runner → runId, progress over SSE", "status": "live" },
    { "method": "GET",    "path": "/events?since=<id>",             "description": "SSE event stream with Last-Event-ID replay (§4.6)", "status": "live" },
    { "method": "GET",    "path": "/state",                        "description": "Dashboard bootstrap state", "status": "live" },
    { "method": "GET",    "path": "/traces/:callId",                "description": "Request trace spans", "status": "live" },
    { "method": "GET",    "path": "/audit?limit=50",                "description": "Audit records (§4.7)", "status": "live" },
    { "method": "GET",    "path": "/audit/verify",                  "description": "Hash-chain verification: { ok, headHash, brokenAt?, reason? }", "status": "live" },
    { "method": "GET",    "path": "/audit/export",                  "description": "Export audit records as NDJSON", "status": "live" },
    { "method": "GET",    "path": "/metrics",                       "description": "Counters and latency histograms", "status": "live" },
    { "method": "GET",    "path": "/metrics/timeseries",             "description": "Bucketed metrics series", "status": "live" },
    { "method": "POST",   "path": "/dev/tamper {index}",            "description": "Dev only (ENABLE_DEV_ROUTES=1): tamper audit line at index", "status": "planned" },
    { "method": "GET",    "path": "/health",                        "description": "Health check", "status": "live" }
  ]
}
